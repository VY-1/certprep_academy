type UserProfilePatch = 
 record {
   email: opt text;
   fullName: opt text;
   username: opt text;
 };
type UserProfile = 
 record {
   createdAt: int;
   email: opt text;
   fullName: opt text;
   "principal": principal;
   updatedAt: int;
   username: opt text;
 };
type SyncedAttempt = 
 record {
   id: text;
   payload: text;
 };
type QuestionExplanation = 
 record {
   explanation: text;
   id: text;
 };
type Question = 
 record {
   correctOptionIndex: nat;
   explanation: text;
   id: text;
   isScored: bool;
   knowledgeDomain: KnowledgeDomain;
   options: vec text;
   "text": text;
   versionId: text;
 };
type KnowledgeDomain = 
 variant {
   FederalRequirements;
   Medications;
   OrderEntry;
   Other: text;
   PatientSafety;
 };
type ExamVersion = 
 record {
   examId: text;
   id: text;
   scoredQuestions: nat;
   timeLimitMinutes: nat;
   totalQuestions: nat;
   versionName: text;
 };
type CertificationExam = 
 record {
   description: text;
   id: text;
   name: text;
 };
service : {
  addExam: (exam: CertificationExam) -> ();
  adminUpsertExams: (exs: vec CertificationExam) -> ();
  adminUpsertExplanations: (expls: vec QuestionExplanation) -> ();
  adminUpsertQuestions: (qs: vec Question) -> ();
  getExamDetails: (examId: text) -> (opt CertificationExam) query;
  getExamQuestions: (versionId: text) -> (vec Question) query;
  getExamVersions: (examId: text) -> (vec ExamVersion) query;
  getExams: () -> (vec CertificationExam) query;
  getMyProfile: () -> (opt UserProfile);
  getMyResults: () -> (vec SyncedAttempt);
  saveMyResult: (result: SyncedAttempt) -> ();
  saveMyResultsBatch: (results: vec SyncedAttempt) -> ();
  updateMyProfile: (patch: UserProfilePatch) -> (UserProfile);
  upsertExplanations: (expls: vec QuestionExplanation) -> ();
  upsertQuestions: (qs: vec Question) -> ();
  whoami: () -> (principal);
}
